    },
    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Nil when no model ran for this context: no model registered for the flow, a control assignment,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "a load failure, or an extension build. A score is in whatever range its head defines — the SDK",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "ascribes no meaning to the value and does not assume ",
              "type" : "text"
            },
            {
              "code" : "[0, 1]",
              "type" : "codeVoice"
            },
            {
              "text" : ". Outputs declared ",
              "type" : "text"
            },
            {
              "code" : "array",
              "type" : "codeVoice"
            },
            {
              "text" : " are not",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "included; they ride the prediction payload only.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "A value here is exactly what the model emitted, so it ",
                  "type" : "text"
                },
                {
                  "inlineContent" : [
                    {
                      "text" : "can be ",
                      "type" : "text"
                    },
                    {
                      "code" : "NaN",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " or infinite",
                      "type" : "text"
                    }
                  ],
                  "type" : "strong"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "if the model produced one — check with ",
                  "type" : "text"
                },
                {
                  "code" : "isFinite",
                  "type" : "codeVoice"
                },
                {
                  "text" : " before acting on a score. The SDK does not",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "substitute a stand-in, because an invented finite score is indistinguishable from a real one.",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "(The copy the SDK uploads does substitute ",
                  "type" : "text"
                },
                {
                  "code" : "0",
                  "type" : "codeVoice"
                },
                {
                  "text" : ", since JSON cannot carry a ",
                  "type" : "text"
                },
                {
                  "code" : "NaN",
                  "type" : "codeVoice"
                },
                {
                  "text" : "; that",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "substitution never reaches this property.)",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "Important",
          "style" : "important",
          "type" : "aside"
        }
      ],
      "kind" : "content"
    }
