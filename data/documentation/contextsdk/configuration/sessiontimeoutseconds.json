          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "A session lasts while the app is in the foreground and stays the same across brief",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "background\/foreground transitions (e.g. pulling down the notification shade). It only rolls",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "over to a new session when the app returns to the foreground after being backgrounded for at",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "least this long (or after the app is relaunched). Defaults to ",
              "type" : "text"
            },
            {
              "code" : "300",
              "type" : "codeVoice"
            },
            {
              "text" : " (5 minutes). Values of",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "0",
              "type" : "codeVoice"
            },
            {
              "text" : " or less are ignored and the default is used instead.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
