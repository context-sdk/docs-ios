        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Use this method to provide a closure that can modify or replace the notification content",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "built by ContextSDK before it is displayed to the user. You can use this if you want to further modify",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the content before it is displayed.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "The closure receives the notification content built by ContextSDK and the user info",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "dictionary that was used to build it. You can modify the content in place or return",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "a completely new ",
              "type" : "text"
            },
            {
              "code" : "UNNotificationContent",
              "type" : "codeVoice"
            },
            {
              "text" : " instance.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Set to ",
              "type" : "text"
            },
            {
              "code" : "nil",
              "type" : "codeVoice"
            },
            {
              "text" : " to disable customization and use the default notification content.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Example",
          "level" : 2,
          "text" : "Example",
          "type" : "heading"
        },
        {
          "code" : [
            "ContextPush.setNotificationContentCustomizer { content, userInfo in",
            "    \/\/ Add a custom subtitle based on app state",
            "    content.subtitle = \"Special offer just for you!\"",
            "",
            "    \/\/ Add custom sound",
            "    content.sound = UNNotificationSound(named: UNNotificationSoundName(\"custom.caf\"))",
            "",
            "    return content",
            "}"
          ],
