      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The window is the ",
              "type" : "text"
            },
            {
              "code" : "supportedDuration",
              "type" : "codeVoice"
            },
            {
              "text" : " of the model registered for ",
              "type" : "text"
            },
            {
              "code" : "flowName",
              "type" : "codeVoice"
            },
            {
              "text" : ", or 3 seconds when",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the flow has no model — so a caller with a model-backed flow never has to know or repeat the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "duration its model was trained for. Prefer this over the ",
              "type" : "text"
            },
            {
              "code" : "duration:",
              "type" : "codeVoice"
            },
            {
              "text" : " overload, where a value",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "that disagrees with the model silently downgrades the flow to the control group.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
