        },
        {
          "inlineContent" : [
            {
              "text" : "Call this from your ",
              "type" : "text"
            },
            {
              "code" : "UIApplicationDelegate.applicationDidReceiveMemoryWarning(_:)",
              "type" : "codeVoice"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "(or ",
              "type" : "text"
            },
            {
              "code" : "UIViewController.didReceiveMemoryWarning()",
              "type" : "codeVoice"
            },
            {
              "text" : ") to let ContextSDK shrink its",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "caches. The accelerometer ring buffer is trimmed to the minimum window needed",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "to satisfy ",
              "type" : "text"
            },
            {
              "code" : "fetchContext",
              "type" : "codeVoice"
            },
            {
              "text" : " \/ ",
              "type" : "text"
            },
            {
              "code" : "instantContext",
              "type" : "codeVoice"
            },
            {
              "text" : " calls, and internal cached state",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "that can be re-derived is released.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Recent contexts created via your own flow names are preserved so that",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/org.cocoapods.ContextSDK\/documentation\/ContextSDK\/ContextManager\/recentContext(flowName:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " continues to return them.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
