{
  "abstract" : [
    {
      "text" : "Call this configure the test name and cohort name of the current app installation.",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "This is useful when you are using your own A\/B testing system already and want to align experiment data with ContextSDK.",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "ContextSDK will store the values set here so they are immediately applied on the next app start, you should still call this method as early as possible during the app lifecycle to ensure the values are current, and the correct configuration is applied to the installation.",
      "type" : "text"
    }
  ],
