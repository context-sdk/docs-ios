      "parameters" : [
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "The test the user is currently part of. If your users are part of multiple tests at the same time this is only used to differentiate between people that are part of the group using ContextSDK for decision making, and the all other users in your user base.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "testName"
        },
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "The name of the cohort inside the specified test. This is usually “control” for people where ContextSDK makes no decisions, and “context_sdk” for people where a custom ML model is deployed for decision making. Splitting into more than 2 cohorts is fully supported.",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "cohortName"
        }
      ]
    }
