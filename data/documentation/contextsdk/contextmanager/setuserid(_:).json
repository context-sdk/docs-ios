      "parameters" : [
        {
          "content" : [
            {
              "inlineContent" : [
                {
                  "text" : "A unique string that identifies the current user in your system, or ",
                  "type" : "text"
                },
                {
                  "code" : "nil",
                  "type" : "codeVoice"
                },
                {
                  "text" : " to clear a",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "previously set user id (for example on sign-out).",
                  "type" : "text"
                }
              ],
              "type" : "paragraph"
            }
          ],
          "name" : "userId"
        }
      ]
    },
    {
      "content" : [
        {
          "anchor" : "discussion",
          "level" : 2,
          "text" : "Discussion",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The user id is shared across all ContextSDK products: it’s attached as a signal to every ContextSDK event",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "from now on, and, when you also use ContextSDK Push, it’s used to associate the device token with the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "signed-in user (you then only need to provide the device token via ",
              "type" : "text"
            },
            {
              "code" : "ContextPush.setDeviceToken(_:)",
              "type" : "codeVoice"
            },
            {
              "text" : "). It’s",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "stored on the device, so it’s available again on the next app start without you having to set it once more.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Call this again whenever the signed-in user changes to overwrite the previous value.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
